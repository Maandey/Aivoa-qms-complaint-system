# AIVOA - AI-Powered Customer Complaint Management System
# Configuration

# Groq API Configuration (Models: gemma2-9b-it, llama-3.3-70b-versatile)
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it

# Database Configuration (SQLite by default, or PostgreSQL / MySQL)
# SQLite: sqlite:///./qms_complaints.db
# PostgreSQL: postgresql://user:password@localhost:5432/qms_db
# MySQL: mysql+pymysql://user:password@localhost:3306/qms_db
DATABASE_URL=sqlite:///./qms_complaints.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
